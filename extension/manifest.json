{
  "manifest_version": 3,
  "name": "Apogee Veille",
  "version": "0.4.0",
  "description": "Sauvegarde les pubs de la Meta Ad Library dans Apogee et vérifie chaque jour les marques suivies.",
  "permissions": [
    "storage",
    "scripting",
    "alarms"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "arriere-plan.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/ads/library/*"
      ],
      "js": [
        "interception.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.facebook.com/ads/library/*"
      ],
      "js": [
        "contenu.js"
      ],
      "run_at": "document_start"
    }
  ]
}
