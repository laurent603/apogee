# ============================================================
# LEADSCORE — Variables d'environnement
# Copiez ce fichier en .env.local et remplissez les valeurs
# ============================================================

# --- Base de données (Neon PostgreSQL — gratuit sur neon.tech) ---
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."

# --- NextAuth (générez un secret avec: openssl rand -base64 32) ---
NEXTAUTH_URL="https://votre-domaine.com"
NEXTAUTH_SECRET="votre-secret-aleatoire-32-caracteres"

# --- Facebook / Meta App ---
# Créez votre app sur https://developers.facebook.com
FACEBOOK_CLIENT_ID="votre-facebook-app-id"
FACEBOOK_CLIENT_SECRET="votre-facebook-app-secret"

# --- Anthropic (Claude AI) ---
# Trouvez votre clé sur https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxx"

# --- Meta Marketing API ---
META_API_VERSION="v21.0"
# Token système (optionnel, pour les accès agence)
META_SYSTEM_USER_TOKEN=""

# --- Envoi d'e-mails (Resend — resend.com) ---
# Sans RESEND_API_KEY, les rapports et les alertes ne partent pas : l'échec est
# enregistré dans l'onglet Notifications plutôt que silencieux.
RESEND_API_KEY=""
# Expéditeur : doit appartenir à un domaine vérifié chez Resend
RESEND_FROM="Leadscore <rapport@votre-domaine.com>"

# --- Alertes d'incident ---
# Destinataire des alertes (échec de lancement, agent en panne, rapport non
# livré) et des confirmations de lancement. Par défaut : laurent@leadscore.fr
ALERT_EMAIL=""

# --- Cron des agents automatiques ---
# Protège /api/cron/agents. À envoyer dans l'en-tête x-cron-secret.
CRON_SECRET=""
