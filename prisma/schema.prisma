generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  image         String?
  facebookId    String?   @unique
  accessToken   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  adAccounts    AdAccount[]
  autopilotAgents AutopilotAgent[]
  launches      LaunchHistory[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model AdAccount {
  id              String   @id @default(cuid())
  metaAccountId   String
  name            String
  currency        String?
  timezone        String?
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandSettings   BrandSettings?
  autopilotAgents AutopilotAgent[]
  reports         Report[]
  createdAt       DateTime @default(now())
  @@unique([userId, metaAccountId])
}

model BrandSettings {
  id                    String   @id @default(cuid())
  adAccountId           String   @unique
  adAccount             AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  // Business
  businessModel         String?
  offerType             String?
  marketPositioning     String?
  companyName           String?
  websiteUrl            String?
  industry              String?
  uniqueValueProp       String?
  productDescription    String?
  companyStage          String?
  catalogSize           String?
  averageOrderValue     Float?
  productMarginPct      Float?
  repeatPurchaseRatePct Float?
  // Audience
  audienceType          String?
  targetAudience        String?
  ageRange              String?
  gender                String?
  targetPersona         String?
  buyerRole             String?
  awarenessLevel        String?
  audienceObjections    String?
  campaignRegions       String?
  // Goals & KPIs
  primaryObjective      String?
  primaryKpiTarget      String?
  secondaryObjective    String?
  strategicGoal         String?
  shortTermGoal         String?
  monthlyAdBudget       Float?
  monthlyConvTarget     Int?
  budgetFlexibility     String?
  targetCpa             Float?
  maxCpa                Float?
  targetRoas            Float?
  targetMer             Float?
  priceRange            String?
  // Market
  competitors           String?
  seasonality           String?
  peakMonths            String?
  conversionChannel     String?
  landingPageType       String?
  trackingSetup         String?
  crmIntegration        String?
  // 'total' | 'meta' | 'website' — see LeadSource in src/lib/meta.ts
  leadSource            String?  @default("total")
  trackedEvents         String?
  trustpilotUrl         String?
  updatedAt             DateTime @updatedAt
}

model AutopilotAgent {
  id             String   @id @default(cuid())
  name           String
  description    String?
  role           String   // performance_manager | media_buyer | creative_strategist | copywriter
  frequency      String   // daily | every_3_days | weekly | monthly
  runMode        String   @default("report") // report | propose | auto_execute
  analysisPeriod String   @default("last_7d")
  instructions   String
  outputFormat   String?
  deliveryChannels String  @default("in_app") // JSON array as string
  isActive       Boolean  @default(true)
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  userId         String
  adAccountId    String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  adAccount      AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  reports        Report[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model LaunchHistory {
  id            String   @id @default(cuid())
  userId        String
  metaAccountId String
  campaignName  String
  campaignId    String?
  objective     String?
  structure     String?
  adsetCount    Int      @default(0)
  adCount       Int      @default(0)
  status        String   @default("success")
  logs          String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
}

model Report {
  id             String   @id @default(cuid())
  title          String
  type           String   // audit | performance | media_buying | creative | autopilot
  content        String   // HTML or Markdown
  adAccountId    String
  adAccount      AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  agentId        String?
  agent          AutopilotAgent? @relation(fields: [agentId], references: [id])
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())
}
