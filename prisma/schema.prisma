generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String   @id @default(cuid())
  name        String?
  email       String?  @unique
  image       String?
  facebookId  String?  @unique
  accessToken String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  accounts        Account[]
  sessions        Session[]
  adAccounts      AdAccount[]
  autopilotAgents AutopilotAgent[]
  launches        LaunchHistory[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AdAccount {
  id              String             @id @default(cuid())
  metaAccountId   String
  name            String
  currency        String?
  timezone        String?
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandSettings   BrandSettings?
  autopilotAgents AutopilotAgent[]
  reports         Report[]
  knowledge       CreativeKnowledge?
  copyGenerations CopyGeneration[]
  ghl             GhlConnection?
  createdAt       DateTime           @default(now())

  @@unique([userId, metaAccountId])
}

/// Reference ad copy pulled from the account's Notion workspace. Synced on
/// demand, never per analysis: ~100 pages is ~100 Notion calls at ~3 req/s.
model CreativeKnowledge {
  id             String    @id @default(cuid())
  adAccountId    String    @unique
  adAccount      AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  notionToken    String?
  notionSourceId String?
  /// Normalised items as JSON, injected into the creative prompts
  content        String?
  itemCount      Int       @default(0)
  syncedAt       DateTime?
  syncError      String?
  updatedAt      DateTime  @updatedAt
}

/// Generated ad copy. Deliberately its own table rather than a Report subtype:
/// it belongs to the Creative Strategist page and must never surface in the
/// reports history, which a type filter could silently stop enforcing.
model CopyGeneration {
  id          String    @id @default(cuid())
  adAccountId String
  adAccount   AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  mode        String
  awareness   String?
  product     String
  offer       String?
  audience    String?
  tone        String?
  cta         String?
  /// The generated variants as JSON
  result      String
  createdAt   DateTime  @default(now())

  @@index([adAccountId, createdAt])
}

/// GoHighLevel pipeline data joined to Meta ads through utmAdId, so a creative
/// can be judged on the value of what it brings in and not only on lead cost.
/// Synced on demand and cached: analyses must not wait on a third-party API.
model GhlConnection {
  id          String    @id @default(cuid())
  adAccountId String    @unique
  adAccount   AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  /// Private integration token — scoped to one GHL sub-account
  token       String?
  locationId  String?
  /// Per-ad aggregates as JSON, keyed by Meta ad id
  adStats     String?
  totalOpps   Int       @default(0)
  attributed  Int       @default(0)
  wonCount    Int       @default(0)
  wonValue    Float     @default(0)
  valueFilled Int       @default(0)
  /// Les étiquettes qui marquent chaque étape du tunnel, telles qu'elles sont
  /// écrites dans GHL. Elles varient d'un client à l'autre : « rdv booké » ici,
  /// « RDV pris » ailleurs. Vides, les compteurs correspondants restent à zéro
  /// plutôt que de deviner.
  tagLead     String?
  tagRdv      String?
  tagDevis    String?
  tagSigne    String?
  syncedAt    DateTime?
  syncError   String?
  updatedAt   DateTime  @updatedAt
}

model BrandSettings {
  id                    String    @id @default(cuid())
  adAccountId           String    @unique
  adAccount             AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  // Business
  businessModel         String?
  offerType             String?
  marketPositioning     String?
  companyName           String?
  websiteUrl            String?
  industry              String?
  uniqueValueProp       String?
  productDescription    String?
  companyStage          String?
  catalogSize           String?
  averageOrderValue     Float?
  productMarginPct      Float?
  repeatPurchaseRatePct Float?
  // Audience
  audienceType          String?
  targetAudience        String?
  ageRange              String?
  gender                String?
  targetPersona         String?
  buyerRole             String?
  awarenessLevel        String?
  audienceObjections    String?
  campaignRegions       String?
  // Goals & KPIs
  primaryObjective      String?
  secondaryObjective    String?
  strategicGoal         String?
  shortTermGoal         String?
  monthlyAdBudget       Float?
  monthlyConvTarget     Int?
  budgetFlexibility     String?
  targetCpa             Float?
  maxCpa                Float?

  /// ── Seuils du moteur de décision ─────────────────────────────────────
  /// Chacun remplace une constante qui était écrite en dur. Laissés vides,
  /// les défauts du moteur s'appliquent : un compte non réglé se comporte
  /// exactement comme avant.
  /// Cible distincte sur audience chaude : juger un retargeting et une
  /// audience froide au même seuil en mal-classe forcément l'un des deux.
  cpaCibleRetargeting   Float?
  /// Une créa passe si son coût reste sous cible × ce facteur.
  toleranceWinner       Float?
  /// Dépense minimale avant de juger, en multiples de la cible.
  facteurRegardable     Float?
  /// Dépense qui valide un winner, en multiples de la cible.
  facteurConfirme       Float?
  /// Résultats minimum pour conclure — publicités, puis campagnes et ad sets.
  volumeMinWinner       Int?
  volumeMinEntite       Int?
  /// Hook rate minimal exigé d'une vidéo pour être winner.
  hookMinWinner         Float?
  /// Fréquence à partir de laquelle l'audience est jugée sous pression.
  freqFatigue           Float?
  /// En dessous, le clic est considéré comme décroché.
  linkCtrFaible         Float?
  ctrFaible             Float?
  /// Âge en deçà duquel une ligne sans signal reste un test, pas un problème.
  joursNouveauTest      Int?

  /// ── Économie du compte ───────────────────────────────────────────────
  /// Part de la marge par client qu'on accepte de consacrer à l'acquisition.
  /// Le reste est le profit. `averageOrderValue` et `productMarginPct`
  /// portent déjà la valeur client et la marge.
  partAcquisition       Float?
  /// Caler les verdicts sur le CPL déduit du tunnel plutôt que sur `targetCpa`.
  cplDerive             Boolean   @default(false)
  targetRoas            Float?
  targetMer             Float?
  priceRange            String?
  // Market
  competitors           String?
  seasonality           String?
  peakMonths            String?
  conversionChannel     String?
  landingPageType       String?
  trackingSetup         String?
  crmIntegration        String?
  // 'total' | 'meta' | 'website' — see LeadSource in src/lib/meta.ts
  leadSource            String?   @default("total")
  /// Reports are emailed here for every agent on the account, so the address is
  /// entered once instead of on each agent
  reportEmail           String?
  reportEmailEnabled    Boolean   @default(false)
  trackedEvents         String?
  trustpilotUrl         String?
  updatedAt             DateTime  @updatedAt
}

model AutopilotAgent {
  id               String    @id @default(cuid())
  name             String
  description      String?
  role             String // performance_manager | media_buyer | creative_strategist | copywriter
  frequency        String // daily | every_3_days | weekly | monthly
  runMode          String    @default("report") // report | propose | auto_execute
  analysisPeriod   String    @default("last_7d")
  instructions     String
  outputFormat     String?
  deliveryChannels String    @default("in_app") // JSON array as string
  isActive         Boolean   @default(true)
  lastRunAt        DateTime?
  nextRunAt        DateTime?
  userId           String
  adAccountId      String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  adAccount        AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  reports          Report[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model LaunchHistory {
  id            String   @id @default(cuid())
  userId        String
  metaAccountId String
  campaignName  String
  campaignId    String?
  objective     String?
  structure     String?
  adsetCount    Int      @default(0)
  adCount       Int      @default(0)
  status        String   @default("success")
  logs          String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
}

model Report {
  id          String          @id @default(cuid())
  title       String
  type        String // audit | performance | media_buying | creative | autopilot
  content     String // HTML or Markdown
  adAccountId String
  adAccount   AdAccount       @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  agentId     String?
  agent       AutopilotAgent? @relation(fields: [agentId], references: [id])
  /// La publicité analysée, quand l'analyse en vise une.
  ///
  /// Sans elle, un rapport ne porte que le compte et un titre générique : on
  /// ne peut ni le retrouver depuis la créa, ni comparer deux analyses de la
  /// même créa à un mois d'écart. Le nom est copié plutôt que rejoint —
  /// il doit rester lisible même si la publicité disparaît de Meta.
  adId        String?
  adName      String?
  isRead      Boolean         @default(false)
  createdAt   DateTime        @default(now())

  @@index([adAccountId, createdAt])
  @@index([adId])
}

/// Campagnes, adsets et publicités Meta, avec leur nom et leur statut.
///
/// Séparé des chiffres : un nom se répète à l'identique sur 365 jours, le
/// stocker dans la table de faits gonflerait celle-ci pour rien. L'objectif
/// est ici parce que `resolvePrimaryResult` en a besoin — sans lui, impossible
/// de savoir si le « résultat » d'une campagne est un prospect, un itinéraire
/// ou une personne touchée.
model MetaEntity {
  id              String    @id @default(cuid())
  adAccountId     String
  level           String // campaign | adset | ad
  metaId          String
  name            String
  status          String?
  effectiveStatus String?
  objective       String? // campagnes seulement
  parentMetaId    String? // ad -> adset, adset -> campaign
  dailyBudget     Float?
  lifetimeBudget  Float?
  createdTime     DateTime?
  /// Publicités seulement : de quoi afficher la galerie de créas. Le format
  /// se déduit d'abord du nom, la convention primant sur l'emballage Meta.
  thumbnailUrl    String?
  creativeType    String?
  creativeId      String?
  syncedAt        DateTime  @default(now())

  @@unique([level, metaId])
  @@index([adAccountId, level])
  @@index([parentMetaId])
}

/// Un enregistrement par publicité, par jour et par fenêtre d'attribution.
///
/// Deux règles portent cette table :
///
/// 1. **Aucun ratio n'est stocké.** CPL, CTR, hook rate et compagnie se
///    recalculent à la lecture depuis les numérateurs et dénominateurs. Un
///    CPL de période ne s'obtient pas en moyennant des CPL journaliers : il
///    faut diviser la dépense totale par les prospects totaux. Stocker le
///    ratio, c'est garantir des chiffres faux dès qu'on agrège.
/// 2. **L'attribution fait partie de la clé.** Le même jour, la même pub, ne
///    déclare pas les mêmes conversions en 1d_click et en 7d_click. Seule la
///    fenêtre par défaut du compte est synchronisée au départ ; les autres se
///    peuplent à la demande, sans changer le schéma.
model MetaDailyAd {
  id            String   @id @default(cuid())
  adAccountId   String // AdAccount.id interne
  metaAccountId String // act_xxx, pour les requêtes directes
  date          DateTime @db.Date
  adId          String
  adsetId       String?
  campaignId    String?
  attribution   String   @default("default") // default | 1d_click | 7d_click | 1d_view

  spend          Float @default(0)
  impressions    Int   @default(0)
  reach          Int   @default(0)
  clicks         Int   @default(0)
  linkClicks     Int   @default(0)
  outboundClicks Int   @default(0)

  // Tunnel du clic à l'achat
  landingPageViews Int   @default(0)
  addToCart        Int   @default(0)
  initiateCheckout Int   @default(0)
  purchases        Int   @default(0)
  revenue          Float @default(0)

  // Prospects : trois sources tenues séparées, Meta les déclarant sur trois
  // lignes distinctes. Les fusionner sous-compte les comptes qui ont les deux.
  formLeads  Int @default(0)
  pixelLeads Int @default(0)
  totalLeads Int @default(0)

  // Résultats alternatifs, pour les objectifs qui ne comptent ni prospect ni achat
  directions     Int @default(0)
  postEngagement Int @default(0)

  videoStarts Int @default(0)
  video3s     Int @default(0)
  video15s    Int @default(0)
  thruplays   Int @default(0)
  video25     Int @default(0)
  video50     Int @default(0)
  video75     Int @default(0)
  video95     Int @default(0)

  syncedAt DateTime @default(now())

  @@unique([adId, date, attribution])
  @@index([adAccountId, date])
  @@index([campaignId, date])
  @@index([adsetId, date])
  @@index([date])
}

/// Portée dédupliquée par période, que l'addition des jours ne peut pas donner.
///
/// Meta compte des personnes uniques : quelqu'un touché lundi et mardi compte
/// une fois sur la semaine, deux fois si on somme les journées. La fréquence
/// qui en découle serait donc systématiquement sous-estimée — et la règle de
/// fatigue, qui se déclenche au-delà de 2,6, ne se déclencherait jamais.
///
/// On demande donc à Meta la portée réelle sur les fenêtres de travail. Une
/// période personnalisée n'en a pas et affiche une fréquence marquée comme
/// approchée plutôt qu'un chiffre faux présenté comme exact.
model MetaPeriodReach {
  id          String   @id @default(cuid())
  adAccountId String
  level       String // campaign | adset | ad
  metaId      String
  /// Fenêtre glissante : 7d | 14d | 30d | 90d
  window      String
  reach       Int      @default(0)
  impressions Int      @default(0)
  syncedAt    DateTime @default(now())

  @@unique([level, metaId, window])
  @@index([adAccountId, window, level])
}

/// Où en est la synchronisation de chaque compte.
///
/// `lastSyncedAt` ne suffit pas : Meta réattribue les conversions pendant
/// plusieurs jours, donc chaque passage réécrit une fenêtre glissante récente
/// plutôt que d'ajouter aveuglément à la suite.
model MetaSyncState {
  id             String    @id @default(cuid())
  adAccountId    String    @unique
  metaAccountId  String
  /// Jour le plus ancien déjà récupéré — la reprise d'historique remonte
  /// progressivement pour ne pas se faire limiter par Meta.
  backfilledFrom DateTime? @db.Date
  lastSyncedAt   DateTime?
  lastError      String?
  rowsTotal      Int       @default(0)
  updatedAt      DateTime  @updatedAt
}

/// Journal des incidents remontés dans l'onglet Notifications.
///
/// Volontairement sans clé étrangère : écrire un incident ne doit jamais
/// échouer parce que le compte a disparu, et supprimer un compte ne doit pas
/// effacer l'historique des pannes qu'il a provoquées.
model ErrorLog {
  id          String    @id @default(cuid())
  level       String    @default("error") // error | warning
  source      String // launch | agent_cron | agent_chat | comments | delivery | enrichment
  title       String
  message     String // toujours passé par redact() avant écriture
  cause       String? // interprétation lisible quand on sait la déduire
  context     String? // extrait de journal / détail, redacted lui aussi
  adAccountId String?
  accountName String?
  agentName   String?
  /// Regroupe les occurrences d'une même panne : source + compte + message
  /// normalisé. C'est la clé de la déduplication du mail sur 24 h.
  fingerprint String
  occurrences Int       @default(1)
  mailedAt    DateTime?
  isRead      Boolean   @default(false)
  lastSeenAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([fingerprint])
  @@index([createdAt])
  @@index([isRead])
}

/// Le tunnel CRM, un enregistrement par jour.
///
/// Stocké par journée et non en total, pour la même raison que les insights
/// Meta : le cockpit doit pouvoir lire 7, 30 ou 90 jours, et comparer à la
/// période précédente. Des compteurs figés ne vaudraient que pour la fenêtre
/// de la dernière synchro.
model GhlDaily {
  id          String   @id @default(cuid())
  adAccountId String
  date        DateTime @db.Date

  /// Contacts portant l'étiquette de lead, créés ce jour-là.
  leads  Int   @default(0)
  rdv    Int   @default(0)
  devis  Int   @default(0)
  signes Int   @default(0)
  /// Chiffre d'affaires des opportunités gagnées ce jour-là.
  ca     Float @default(0)

  syncedAt DateTime @default(now())

  @@unique([adAccountId, date])
  @@index([adAccountId, date])
}
